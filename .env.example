# 复制为 .env 并填入实际值（.env 已被 .gitignore 忽略，切勿提交）

# Flask
SECRET_KEY=change-me
FLASK_CONFIG=development

# 数据库 (MySQL)
DATABASE_URL=mysql+pymysql://root:root@localhost:3306/iotcloud?charset=utf8mb4

# JWT
JWT_SECRET_KEY=change-me-jwt

# InfluxDB
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=
INFLUXDB_ORG=iotcloud
INFLUXDB_BUCKET=telemetry

# Redis
REDIS_URL=redis://localhost:6379/0

# MQTT (EMQX)
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_CLIENT_ID=iotcloud-backend

# 跨域
CORS_ORIGINS=*
